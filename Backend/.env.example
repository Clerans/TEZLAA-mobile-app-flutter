# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database (Supabase / Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# PayHere Payment Gateway Configuration
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox
PAYHERE_NOTIFY_URL=https://api.tezlaa.com/api/v1/payments/payhere/notify

# Image Management (Cloudinary)
CLOUDINARY_CLOUD_NAME=tezlaa-cloud
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Mail Service (Brevo API & SMTP)
BREVO_API_KEY=your_brevo_api_key_here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_key_or_password
EMAIL_FROM="TEZLAA Artisan Café <support@tezlaa.com>"

# SMS Gateway Provider (Pluggable Provider)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=TEZLAA
